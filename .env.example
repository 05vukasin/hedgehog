# hedgehog — LLM credentials for testing AI features (summaries, llm.ask, llm.bench).
# Copy to .env and fill in what you have; leave the rest empty. .env is git-ignored.
# Keys passed directly to llm.connect(..., api_key=...) always win over these.
# Names match the sada projects, so values can be copied over as-is.

# Default provider/model when llm.connect() is called without arguments.
# AI_PROVIDER: openai | openai_compatible | anthropic | bedrock | openrouter | groq | vllm
AI_PROVIDER=
AI_CHAT_MODEL=

# --- OpenAI -----------------------------------------------------------------
OPENAI_API_KEY=
# Set to point the OpenAI client at any OpenAI-compatible server instead.
OPENAI_BASE_URL=
OPENAI_MODEL=

# --- Anthropic --------------------------------------------------------------
ANTHROPIC_API_KEY=
# claude-opus-5-5 (default) | claude-sonnet-5-5 | claude-haiku-5-5 | claude-fable-5-1
ANTHROPIC_MODEL=

# --- AWS Bedrock (Converse API, bearer token) --------------------------------
AI_BEDROCK_BEARER_TOKEN=
AI_BEDROCK_REGION=eu-west-2
# e.g. qwen.qwen3-235b-a22b-2507-v1:0, minimax.minimax-m2.5
AI_BEDROCK_MODEL=

# --- OpenRouter (OpenAI-compatible) -----------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# --- Groq (OpenAI-compatible) -----------------------------------------------
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=

# --- Local / self-hosted OpenAI-compatible (vLLM, Ollama, LM Studio) ----------
# /v1 is appended automatically if missing.
API_URL=
API_TOKEN=
API_MODEL=

# --- Limits for test runs ----------------------------------------------------
# Max concurrent LLM calls across the process.
AI_MAX_CONCURRENT_LLM=4
